+                        name: "keycloak".into(),
+                        enabled: true,
+                        bound_issuer: Some(issuer.clone()),
+                        jwks_url: Some(jwks_url.clone()),
+                        ..Default::default()
+                    },
+                ])
+            });
+        federation_mock
+    }
+
