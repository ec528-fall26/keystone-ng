+
+    #[tokio::test]
+    async fn test_token_exchange_accepts_jwt_from_bound_issuer() {
+        use crate::federation::api::oidc_utils::fixtures::{TEST_KID, make_jwt};
+        let server = httpmock::MockServer::start();
