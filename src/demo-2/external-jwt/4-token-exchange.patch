+/// Claims of the token returned for an external subject token. It only says who
+/// the external identity is. There is no `openstack_context`, so OpenStack
+/// services do not accept it as an access token.
+#[derive(serde::Serialize)]
+struct ExternalIdentityClaims {
+    iss: String,
+    sub: String,
+    aud: String,
+    client_id: String,
+    external_issuer: String,
+    exp: i64,
+    iat: i64,
+    nbf: i64,
+    jti: String,
+    token_use: &'static str,
+}
+
+/// Exchange a JWT from an external identity provider. Returns `None` when the
+/// subject token is not a JWT or its issuer is not trusted, so the caller can
+/// handle it as a Keystone token.
+///
+/// The trusted issuers are the `bound_issuer` of the enabled identity providers
+/// of this domain (and the global ones). The token has to be made for the
+/// exchanging client (`aud`).
+async fn exchange_external_jwt(
+    state: &ServiceState,
+    domain_id: &str,
+    headers: &HeaderMap,
+    oauth2_cfg: &openstack_keystone_config::Oauth2Provider,
+    client_id: &str,
+    subject_token: &str,
+) -> Result<Option<Response>, Oauth2TokenError> {
+    let Ok(claimed_issuer) = extract_issuer(subject_token) else {
+        return Ok(None);
+    };
+
+    let idps = state
+        .provider
+        .get_federation_provider()
+        .list_identity_providers(
+            &ExecutionContext::internal(state),
+            &IdentityProviderListParameters {
+                domain_ids: Some(HashSet::from([None, Some(domain_id.to_string())])),
+                ..Default::default()
+            },
+        )
+        .await
+        .map_err(|e| {
+            tracing::warn!(error = %e, "oauth2 token exchange identity provider lookup failed");
+            Oauth2TokenError::internal("token issuance failed")
+        })?;
+    let trusted = trusted_issuers_from_idps(&idps);
+    if !trusted.iter().any(|t| t.issuer == claimed_issuer) {
+        return Ok(None);
+    }
+
+    let http_client = build_http_client().map_err(|e| {
+        tracing::warn!(error = %e, "oauth2 token exchange http client failed");
+        Oauth2TokenError::internal("token issuance failed")
+    })?;
+    let verified = verify_external_jwt(subject_token, &trusted, &[client_id], &http_client)
+        .await
+        .map_err(|e| {
+            tracing::warn!(error = %e, "oauth2 token exchange external subject_token rejected");
+            Oauth2TokenError::invalid_grant(
+                "subject_token is invalid, expired, or not for this client",
+            )
+        })?;
+    let Some(subject) = verified["sub"].as_str() else {
+        return Err(Oauth2TokenError::invalid_grant("subject_token has no sub"));
+    };
+
+    let base = base_url(state, headers).await;
+    let now = chrono::Utc::now().timestamp();
+    let access_lifetime = i64::from(oauth2_cfg.access_token_lifetime_minutes) * 60;
+    let claims = ExternalIdentityClaims {
+        iss: format!("{base}/v4/oauth2/{domain_id}"),
+        sub: subject.to_string(),
+        aud: client_id.to_string(),
+        client_id: client_id.to_string(),
+        external_issuer: claimed_issuer,
+        exp: now + access_lifetime,
+        iat: now,
+        nbf: now,
+        jti: uuid::Uuid::new_v4().to_string(),
+        token_use: "external_identity",
+    };
+    let access_token = sign_jwt(state, domain_id, &claims).await?;
+
+    let response = TokenResponse {
+        access_token,
+        token_type: "Bearer",
+        expires_in: access_lifetime,
+        scope: "external_identity".to_string(),
+        id_token: None,
+        refresh_token: None,
+    };
+    Ok(Some((StatusCode::OK, Json(response)).into_response()))
+}
